# ld-harness — configuración de usuario
#
# `setup.sh` copia este archivo a ~/.config/ld-harness/config.env la primera vez.
# Editá esa copia, no este. Si a una clave le falta valor, el harness usa el suyo.
#
# Precedencia: default del código < ~/.config/ld-harness/config.env < <repo>/.ld-harness.env

# --- prosa -------------------------------------------------------------------

# Idioma de la conversación. El locale implica el trato: es-AR usa voseo.
# Valores: es-AR | es | en
LD_PROSA_CHAT=es-AR

# Idioma de los artefactos: PR body, tickets, docs, mensajes de commit.
# El código no se configura: identificadores y comentarios van siempre en inglés.
# Valores: en | es
LD_PROSA_ARTIFACTS=en

# Trato cuando el locale no lo implica (es-AR ya implica voseo informal).
# Valores: informal | neutral | formal
LD_PROSA_REGISTER=informal
