{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/format-md.sh\"",
            "timeout": 30,
            "statusMessage": "ld-format"
          }
        ]
      }
    ]
  }
}
